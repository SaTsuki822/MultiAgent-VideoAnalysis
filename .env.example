# ============================================================
# GuardEye 配置模板 —— 复制为 .env 后按需填写
# 前缀统一为 GUARDEYE_，与 agents/config.py 的 Settings 字段一一对应
# 全部留空 = 走 mock 降级，可端到端跑通 demo（不依赖 GPU / API key）
# ============================================================

# ---- LLM / VLM ----
# 后端: mock | openai_compatible。mock 用规则模板兜底，用于离线演示与测试。
GUARDEYE_LLM_BACKEND=mock
# OpenAI 兼容接口（DeepSeek / Qwen-Max 等均可，只要走 /chat/completions）
GUARDEYE_LLM_BASE_URL=
GUARDEYE_LLM_API_KEY=
# 规划 / 复核 / 报告用大模型
GUARDEYE_LLM_MODEL=
# L2 初筛小 VLM（经 SGLang 暴露的 OpenAI 兼容端点）
GUARDEYE_VLM_MODEL=

# ---- 向量库 ----
# 后端: memory | qdrant。memory 用纯 Python 余弦相似度，无需外部服务。
GUARDEYE_VECTOR_BACKEND=memory
GUARDEYE_QDRANT_URL=http://localhost:6333
GUARDEYE_QDRANT_API_KEY=

# ---- 三级路由阈值（Phase 3 实验对象）----
GUARDEYE_BASE_FPS=1.0
GUARDEYE_MOTION_MAX_FPS=4.0
GUARDEYE_MOTION_RATIO_THRESHOLD=0.02
GUARDEYE_DEDUP_THRESHOLD=0.95

# ---- verify 跨帧一致性 ----
GUARDEYE_CONSECUTIVE_HIT_WINDOW=3

# ---- 记忆防污染 ----
GUARDEYE_FP_SIMILARITY_THRESHOLD=0.85
GUARDEYE_FP_ACTIVATION_COUNT=2
GUARDEYE_NEVER_SUPPRESS_SEVERITY=high

# ---- 并发 ----
GUARDEYE_MAX_CONCURRENCY=4
